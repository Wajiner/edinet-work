ss days) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":1,"shares_outstanding":45527540,"shares_outstanding_excluding_treasury":45363798,"source":"latest_quarterly_earnings_disclosure","treasury_shares":163742},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}