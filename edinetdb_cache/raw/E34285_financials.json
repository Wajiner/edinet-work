edback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":3,"shares_outstanding":12335600,"shares_outstanding_excluding_treasury":12335339,"source":"latest_quarterly_earnings_disclosure","treasury_shares":261},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}