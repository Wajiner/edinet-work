ys) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":1,"shares_outstanding":174510680,"shares_outstanding_excluding_treasury":174510536,"source":"latest_quarterly_earnings_disclosure","treasury_shares":144},"non_consolidated_fields":["avg_annual_salary","revenue_non_consolidated","shares_issued"],"period":"annual"}}