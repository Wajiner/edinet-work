s) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":4,"shares_outstanding":41791502,"shares_outstanding_excluding_treasury":39484430,"source":"latest_quarterly_earnings_disclosure","treasury_shares":2307072},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}