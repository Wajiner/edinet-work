sistent mismatch (>5 business days) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":2,"shares_outstanding":31948000,"shares_outstanding_excluding_treasury":31038863,"source":"latest_quarterly_earnings_disclosure","treasury_shares":909137},"non_consolidated_fields":["avg_annual_salary","revenue_non_consolidated","shares_issued"],"period":"annual"}}