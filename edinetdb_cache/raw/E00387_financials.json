s_outstanding for market-cap. We monitor this invariant daily with an internal alert. Please report any persistent mismatch (>5 business days) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":1,"shares_outstanding":155658402,"shares_outstanding_excluding_treasury":154433017,"source":"latest_quarterly_earnings_disclosure","treasury_shares":1225385},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}