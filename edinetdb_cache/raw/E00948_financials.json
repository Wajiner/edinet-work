ease report any persistent mismatch (>5 business days) to feedback@edinetdb.jp. See docs/field-notes/latest_shares_snapshot.md.","quarter":1,"shares_outstanding":50119190,"shares_outstanding_excluding_treasury":44079398,"source":"latest_quarterly_earnings_disclosure","treasury_shares":6039792},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}