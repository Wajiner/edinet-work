hot.md.","quarter":1,"shares_outstanding":23534752,"shares_outstanding_excluding_treasury":22121083,"source":"latest_quarterly_earnings_disclosure","treasury_shares":1413669},"non_consolidated_fields":["avg_annual_salary","dividend_per_share","payout_ratio_reported","revenue_non_consolidated","shares_issued"],"period":"annual"}}